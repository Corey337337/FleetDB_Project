<Page x:Class="FleetDB_Project.Pages.VehiclesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FleetDB_Project.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="VehiclesPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="10">
            <StackPanel>
                <Label Content="Поиск по модели"/>
                <TextBox Padding="5" Name="SearchBox"/>
            </StackPanel>

            <StackPanel>
                <Label Content="Фильтрация по статусу"/>
                <ComboBox Name="StatusBox"/>
            </StackPanel>

            <StackPanel>
                <Label Content="Сортировка"/>
                <ComboBox Name="SortBox" SelectedIndex="0">
                    <ComboBoxItem Content="Модель А-Я"/>
                    <ComboBoxItem Content="Модель Я-А"/>
                    <ComboBoxItem Content="Пробег: по возрастанию"/>
                    <ComboBoxItem Content="Пробег: по убыванию"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 20 0 0">
                <Button Content="Применить" Padding="10" Click="ApplyFilter_Click"/>
                <Button Content="Сбросить" Padding="10"
         Margin="10,0,0,0"
         Click="ResetFilter_Click" Width="88"/>
            </StackPanel>



        </StackPanel>

        <DataGrid Grid.Row="1" Name="CarsGrid"
               AutoGenerateColumns="False"
               IsReadOnly="True"
               CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" />
                <DataGridTextColumn Header="Гос. номер" Binding="{Binding LicensePlate}" />
                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" />
                <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" />
                <DataGridTextColumn Header="Год производства" Binding="{Binding YearOfManafacture}" />
                <DataGridTextColumn Header="Пробег" Binding="{Binding Mileage}" />
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" />

                <DataGridTemplateColumn Header="Действие">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Button Content="Редактировать" Margin="5" Padding="10,5" Click="Edit"/>
                                <Button Content="Удалить" Margin="5" Padding="10,5" Click="Delete"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="10">
            <Button Content="Добавить транспортное средство" 
                HorizontalAlignment="Left"
                Padding="15 10" 
                Click="AddNewVehicle_Click"/>
        </StackPanel>

    </Grid>
</Page>
