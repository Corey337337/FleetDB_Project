<Page x:Class="FleetDB_Project.Pages.DriversPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FleetDB_Project.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DriversPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="10">
            <StackPanel>
                <Label Content="Поиск по имени"/>
                <TextBox Padding="5" Name="SearchBox"/>
            </StackPanel>

            <StackPanel>
                <Label Content="Фильтрация по стажу"/>
                <ComboBox Name="ExpBox"/>
            </StackPanel>

            <StackPanel>
                <Label Content="Сортировка"/>
                <ComboBox Name="SortBox" SelectedIndex="0">
                    <ComboBoxItem Content="Имя А-Я"/>
                    <ComboBoxItem Content="Имя Я-А"/>
                    <ComboBoxItem Content="Стаж: по возрастанию"/>
                    <ComboBoxItem Content="Стаж: по убыванию"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 20 0 0">
                <Button Content="Применить" Padding="10"  Click="ApplyFilter_Click"/>
                <Button Content="Сбросить" Padding="10"
                Margin="10,0,0,0"
                Click="ResetFilter_Click" Width="88"/>
            </StackPanel>



        </StackPanel>

        <DataGrid Grid.Row="1" Name="DriversGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" />
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" />
                <DataGridTextColumn Header="Удостоверение" Binding="{Binding LicenseNumber}" />
                <DataGridTextColumn Header="Телефон" Binding="{Binding PhoneNumber}" />
                <DataGridTextColumn Header="Стаж" Binding="{Binding Experience}" />
                <DataGridTextColumn Header="Почта" Binding="{Binding Email}" />


                <DataGridTemplateColumn Header="Действие">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Button Content="Редактировать" Margin="5" Padding="10,5" Click="Edit"/>
                                <Button Content="Удалить" Margin="5" Padding="10,5" Click="Delete"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="10">
            <Button Content="Добавить водителя" 
            HorizontalAlignment="Left"
            Padding="15 10" 
            Click="AddNewDriver_Click"/>
        </StackPanel>

    </Grid>
</Page>
