<Page x:Class="FleetDB_Project.DriversFiles.EditDriverPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FleetDB_Project.DriversFiles"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditDriverPage">

    <Grid>
        <ScrollViewer>
    <StackPanel Margin="20" Width="400">
        <StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Полное имя" Width="150" VerticalAlignment="Center"/>
                <TextBox Name="FullName" Padding="8,4" Width="250"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Водительское удостоверение" Width="150" VerticalAlignment="Center"/>
                <TextBox Name="LicenseNumber" Padding="8,4" Width="250"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Номер телефона" Width="150" VerticalAlignment="Center"/>
                <TextBox Name="PhoneNumber" Padding="8,4" Width="250"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Стаж" Width="150" VerticalAlignment="Center"/>
                <TextBox Name="Experience" Padding="8,4" Width="250"/>
            </StackPanel>
            
        </StackPanel>

        <StackPanel>
            <Button Name="EditDriver" 
                 Content="Редактировать" 

                 Padding="5" 
                 Click="EditDriver_Click"
                    Style="{StaticResource MiniButton}"/>
            <Button Name="Cancel" 
                 Content="Отменить" 
                 Padding="5" 
                 Click="Cancel_Click"
                    Style="{StaticResource MiniButton}"/>
        </StackPanel>
    </StackPanel>
</ScrollViewer>
    </Grid>
</Page>
