<Page x:Class="FleetDB_Project.RoutesFiles.EditRoutePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FleetDB_Project.RoutesFiles"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditRoutePage">

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="20" Width="400">
                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Водитель" Width="150" VerticalAlignment="Center"/>
                        <ComboBox Name="DriverComboBox" 
                       DisplayMemberPath="FullName"
                       SelectedValuePath="Id"
                       Padding="8,4" 
                       Width="250"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Транспортное средство" Width="150" VerticalAlignment="Center"/>
                        <ComboBox Name="VehicleComboBox" 
                       DisplayMemberPath="Model"
                       SelectedValuePath="Id"
                       Padding="8,4" 
                       Width="250"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Дата начала" Width="150" VerticalAlignment="Center"/>
                        <TextBox Name="StartDate" Padding="8,4" Width="250"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Дата окончания" Width="150" VerticalAlignment="Center"/>
                        <TextBox Name="EndDate" Padding="8,4" Width="250"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Начальная локация" Width="150" VerticalAlignment="Center"/>
                        <TextBox Name="StartLocation" Padding="8,4" Width="250"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Конечная локация" Width="150" VerticalAlignment="Center"/>
                        <TextBox Name="EndLocation" Padding="8,4" Width="250"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Расстояние (км)" Width="150" VerticalAlignment="Center"/>
                        <TextBox Name="Distance" Padding="8,4" Width="250"/>
                    </StackPanel>

                </StackPanel>

                <StackPanel>
                    <Button Name="EditRoute" 
                 Content="Редактировать" 
                 Padding="5" 
                 Click="EditRoute_Click"
                            Style="{StaticResource MiniButton}"/>
                    <Button Name="Cancel" 
                 Content="Отменить" 

                 Padding="5" 
                 Click="Cancel_Click"
                            Style="{StaticResource MiniButton}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
