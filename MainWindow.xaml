<Window x:Class="FleetDB_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FleetDB_Project"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="DeepSkyBlue">
    <Grid>
        <Border Background="White"
                CornerRadius="20"
                Padding="35"
                Width="420"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">


            <StackPanel>

                <TextBlock Text="Добро пожаловать"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Управление автопарком"
                           Foreground="#78909C"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,28"/>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Email"/>
                    <TextBox Name="EmailBox" Padding="10,9"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="Пароль"/>
                    <PasswordBox Name="PasswordInput" Padding="10,9"/>
                </StackPanel>

                <Button Content="Войти"
                        Padding="10,11"
                        FontSize="15"
                        Click="Login_Click"/>

                <Button Content="Регистрация"
                        Margin="0,12,0,0"
                        Padding="10,11"
                        FontSize="15"
                        Background="#90A4AE"
                        Click="OpenRegWin_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
