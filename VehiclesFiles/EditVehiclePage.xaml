<Page x:Class="FleetDB_Project.VehiclesFiles.EditVehiclePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FleetDB_Project.VehiclesFiles"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditVehiclePage">

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="20" Width="400">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Гос. номер" Width="150" VerticalAlignment="Center"/>
                        <TextBox Name="LicensePlate" Padding="8,4" Width="250"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Модель" Width="150" VerticalAlignment="Center"/>
                        <TextBox Name="Model" Padding="8,4" Width="250"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Производитель" Width="150" VerticalAlignment="Center"/>
                        <TextBox Name="Manufacturer" Padding="8,4" Width="250"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Год производства" Width="150" VerticalAlignment="Center"/>
                        <TextBox Name="YearOfManafacture" Padding="8,4" Width="250"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Пробег" Width="150" VerticalAlignment="Center"/>
                        <TextBox Name="Mileage" Padding="8,4" Width="250"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Статус" Width="150" VerticalAlignment="Center"/>
                        <ComboBox Name="StatusBox" Width="250" SelectedValuePath="Content" SelectedIndex="0">
                            <ComboBoxItem Content="Доступен"/>
                            <ComboBoxItem Content="В рейсе"/>
                            <ComboBoxItem Content="В ремонте"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <Button Name="EditVehicle" 
                Content="Редактировать" 

                Click="EditVehicle_Click"
                            Style="{StaticResource MiniButton}"/>
                    <Button Name="Cancel" 
                Content="Отменить" 

                Click="Cancel_Click"
                            Style="{StaticResource MiniButton}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
