<Window x:Class="FleetDB_Project.Windows.Reg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FleetDB_Project.Windows"
        mc:Ignorable="d"
        Title="Reg" Height="450" Width="800" Background="DeepSkyBlue" >
    <Grid>



        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="White"
                CornerRadius="12"
                Padding="30"
                Margin="25"
                MaxWidth="620"
                VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.15"/>
                </Border.Effect>

                <StackPanel>

                    <TextBlock Text="Регистрация"
                           FontSize="28"
                           FontWeight="Bold"

                           HorizontalAlignment="Center"/>
                    <TextBlock Text="Заполните данные водителя"
                           Foreground="#78909C"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,25"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
                            <TextBlock Text="Полное имя"/>
                            <TextBox Name="FullNameBox" Padding="10,8"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,16">
                            <TextBlock Text="Номер удостоверения"/>
                            <TextBox Name="LicenceNumberBox" Padding="10,8"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,16">
                            <TextBlock Text="Номер телефона"/>
                            <TextBox Name="PhoneNumberBox" Padding="10,8"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,16">
                            <TextBlock Text="Стаж (лет)"/>
                            <TextBox Name="ExperienceBox" Padding="10,8"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,16">
                            <TextBlock Text="Email"/>
                            <TextBox Name="EmailBox" Padding="10,8"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,16">
                            <TextBlock Text="Пароль"/>
                            <PasswordBox Name="PasswordInput" Padding="10,8"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,16">
                            <TextBlock Text="Повторите пароль"/>
                            <PasswordBox Name="PasswordRepeat" Padding="10,8"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                        <Button Content="Зарегистрироваться"
                            Padding="30,10"
                            Margin="0,0,12,0"
                            Click="Register_Click"/>
                        <Button Content="Закрыть"
                            Padding="30,10"
                            Background="#90A4AE"
                            Click="CloseWindow_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>


    </Grid>
</Window>
